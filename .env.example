APP_NAME="Disdikpora Karangasem"
APP_ENV=local
# Wajib diisi hasil `php artisan key:generate` (contoh: base64:xxxxxxxx==).
# Saat rotasi APP_KEY, simpan key lama (comma-separated) di APP_PREVIOUS_KEYS
# agar session terenkripsi & data Crypt tetap bisa didecrypt (graceful rotation).
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar

# --- APP_URL ---
# Docker (nginx di port 80): http://localhost (nilai default di bawah).
# Native `php artisan serve` (port 8000): http://127.0.0.1:8000 — GANTI bila
# tidak memakai Docker, jika tidak seluruh URL absolut (berkas, redirect,
# email) mengarah ke port 80 yang tidak ada service-nya.
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Docker: DB_HOST=db (nama service di docker-compose.yml).
# Native (MySQL/MariaDB lokal): DB_HOST=127.0.0.1 dan buat database +
# user sesuai DB_DATABASE/DB_USERNAME/DB_PASSWORD di bawah.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=disdikpora
DB_USERNAME=disdikpora
DB_PASSWORD=disdikpora
# Hanya dipakai image Docker MySQL (mysql:8.4) sebagai password root.
DB_ROOT_PASSWORD=root

# --- SESSION / BROADCAST / FILESYSTEM / QUEUE ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# FILESYSTEM_DISK: disk default Laravel. Docker maupun native cukup 'local';
# berkas upload publik tetap memakai disk `public` secara eksplisit.
FILESYSTEM_DISK=local

# QUEUE_CONNECTION: Docker/native memakai 'redis'; bila Redis tidak tersedia
# bisa 'database' (perlu tabel jobs) atau 'sync' (jangan untuk produksi).
QUEUE_CONNECTION=redis

# --- CACHE ---
# Docker: CACHE_STORE=redis (nilai default di bawah).
# Native dengan phpredis 6.x: Laravel 11 bisa error "Cannot use bool as array"
# di RedisTagSet saat operasi cache bertag (mis. PublicCache). Session/queue
# via Redis aman; solusi cepat: CACHE_STORE=file.
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- REDIS ---
# Docker: REDIS_HOST=redis (nama service) dan REDIS_PASSWORD=disdikpora
# (dicocokkan dengan perintah --requirepass di docker-compose.yml).
# Native: REDIS_HOST=127.0.0.1; REDIS_PASSWORD=null bila Redis/Valkey
# lokal berjalan tanpa password.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=disdikpora
REDIS_PORT=6379

# --- MAIL ---
# Docker: MAIL_MAILER=smtp + MAIL_HOST=mailpit (lihat UI Mailpit
# di http://localhost:8025) — nilai default di bawah.
# Native tanpa Mailpit: MAIL_MAILER=log (email ditulis ke log, tidak
# dikirim) atau konfigurasi SMTP server sendiri.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@disdikpora.karangasemkab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_INITIAL_PASSWORD=Password!2026
